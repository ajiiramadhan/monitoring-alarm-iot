# =========================================================
# Environment Variables — IoT Monitoring Alarm
# Copy this file to .env and adjust the values.
# =========================================================

NODE_ENV=production
PORT=3000
FRONTEND_URL=*

# --- Database (used by docker-compose AND backend) ---
DB_HOST=postgres
DB_PORT=5432
DB_NAME=iot_monitoring
DB_USER=iot_user
DB_PASSWORD=aji123

# --- JWT ---
JWT_SECRET=ajiramadhan
JWT_EXPIRES_IN=24h

# --- MQTT (Broker: EMQX/Mosquitto) ---
MQTT_HOST=emqx
MQTT_PORT=1883
MQTT_WS_PORT=8083
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=iot_backend_server

MQTT_TOPIC_BEAM=iot/beam
MQTT_TOPIC_PIR=iot/pir
MQTT_TOPIC_ULTRASONIC=iot/ultrasonic
MQTT_TOPIC_DHT11=iot/dht11
MQTT_TOPIC_BUZZER=iot/buzzer
MQTT_TOPIC_STATUS=iot/status/+

# --- Alert thresholds ---
ALERT_TEMP_MAX=40
ALERT_DIST_MIN=20

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
